# Copy to .env and adjust if needed. .env is git-ignored.

# PostgreSQL (Docker Compose reads these)
POSTGRES_USER=drum
POSTGRES_PASSWORD=drum
POSTGRES_DB=drum_tutor
POSTGRES_PORT=5442

# API
DATABASE_URL=postgres://drum:drum@localhost:5442/drum_tutor
API_PORT=3330
# Signs the session cookie. At least 32 characters. Change it for anything beyond local dev.
COOKIE_SECRET=local-dev-cookie-secret-change-me-0123456789
NODE_ENV=development
